# ─── Shared ────────────────────────────────────────────────────────────────────
NODE_ENV=development

# MongoDB connection string (Atlas or local)
MONGODB_URL=mongodb://localhost:27017/cortex

# Redis URL
REDIS_URL=redis://localhost:6379

# RabbitMQ AMQP URL
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Shared secret used to authenticate internal service-to-service calls.
# Must be identical across all services.
INTERNAL_API_KEY=change-me-to-a-long-random-secret

# ─── Gateway ───────────────────────────────────────────────────────────────────
GATEWAY_PORT=5000
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_MAX=300

# Internal service URLs (used by gateway to proxy requests)
AUTH_SERVICE=http://localhost:5001
CHAT_SERVICE=http://localhost:5002
AGENT_SERVICE=http://localhost:5003
BILLING_SERVICE=http://localhost:5004

# ─── Auth Service ──────────────────────────────────────────────────────────────
# Port for the auth microservice
AUTH_PORT=5001

# ─── Chat Service ──────────────────────────────────────────────────────────────
CHAT_PORT=5002

# ─── Agent Service ─────────────────────────────────────────────────────────────
AGENT_PORT=5003

# LLM API Keys
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Web Search
TAVILY_API_KEY=

# Vector Store (Qdrant)
QDRANT_URL=
QDRANT_API_KEY=

# File Storage Configuration
STORAGE_PROVIDER=local
STORAGE_PATH=./storage/uploads
BACKEND_URL=http://localhost:5000

# ─── Billing Service ───────────────────────────────────────────────────────────
BILLING_PORT=5004

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
