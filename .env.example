# ─── Shared ────────────────────────────────────────────────────────────────────
NODE_ENV=development

# MongoDB Atlas connection string (shared by all services)
MONGODB_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/cortex?retryWrites=true&w=majority

# Redis URL
REDIS_URL=redis://localhost:6379

# Shared secret used to authenticate internal service-to-service calls.
# Must be identical across all services.
INTERNAL_API_KEY=change-me-to-a-long-random-secret

# ─── Gateway ───────────────────────────────────────────────────────────────────
GATEWAY_PORT=5000
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_MAX=300

# Internal service URLs (used by gateway to proxy requests)
AUTH_SERVICE=http://localhost:5001
CHAT_SERVICE=http://localhost:5002
AGENT_SERVICE=http://localhost:5003
BILLING_SERVICE=http://localhost:5004

# ─── Auth Service ──────────────────────────────────────────────────────────────
# Port for the auth microservice
AUTH_PORT=5001

# ─── Chat Service ──────────────────────────────────────────────────────────────
CHAT_PORT=5002

# ─── Agent Service ─────────────────────────────────────────────────────────────
AGENT_PORT=5003

# LLM API Keys
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Web Search
TAVILY_API_KEY=

# Vector Store (Qdrant)
QDRANT_URL=
QDRANT_API_KEY=

# AWS S3 — for file uploads in agent service
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=cortex-ai-uploads

# ─── Billing Service ───────────────────────────────────────────────────────────
BILLING_PORT=5004

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
