# ─── Global Server Configuration ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# MongoDB Connection URL
MONGODB_URL=mongodb://localhost:27017/cortex

# Redis Cache URL
REDIS_URL=redis://localhost:6379

# RabbitMQ AMQP URL (Optional)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Security & Secret Keys
INTERNAL_API_KEY=change-me-to-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_MAX=300

# ─── Firebase Auth Credentials ───────────────────────────────────────────────
# Pass Firebase Service Account JSON string directly or via Base64 string
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ─── AI Agent Provider Keys ──────────────────────────────────────────────────
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Web Search
TAVILY_API_KEY=

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Storage Settings
STORAGE_PROVIDER=local
STORAGE_PATH=./storage/uploads
BACKEND_URL=http://localhost:5000

# ─── Razorpay Billing ────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
